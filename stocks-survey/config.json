{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.3.1/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Stock Market Study Follow-Up Survey",
    "version": "trial",
    "authors": ["VDL"],
    "date": "2025-11-01",
    "description": "A follow-up survey for participants who completed the Evaluating Line Charts using stock market data study.",
    "organizations": ["University of Utah"]
  },
  "uiConfig": {
    "contactEmail": "abrar.nadib@utah.edu",
    "logoPath": "assets/revisitLogoSquare.svg",
    "withProgressBar": true,
    "autoDownloadStudy": false,
    "withSidebar": false,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "studyEndMsg": "**Thank you for completing the study. You may click this link and return to Prolific**: [https://app.prolific.com/submissions/complete?cc=C18Y4XD3](https://app.prolific.com/submissions/complete?cc=C18Y4XD3)**",
    "enumerateQuestions": true
  },
  "components": {
    "introduction": {
      "type": "markdown",
      "path": "stocks-survey/assets/introduction.md",
      "response": [
        {
          "id": "prolificId",
          "prompt": "Please enter your Prolific ID",
          "required": true,
          "location": "belowStimulus",
          "type": "shortText",
          "placeholder": "Prolific ID",
          "paramCapture": "PROLIFIC_PID"
        }
      ]
    },
    "post-study-quant": {
      "type": "questionnaire",
      "response": [
        {
          "id": "stocks-familiarity",
          "type": "likert",
          "location": "belowStimulus",
          "prompt": "How familiar are you with stock market concepts and investing?",
          "required": true,
          "leftLabel": "Not at all familiar",
          "rightLabel": "Extremely familiar",
          "numItems": 7
        },
        {
          "id": "comfortable-numbers",
          "type": "likert",
          "location": "belowStimulus",
          "prompt": "How comfortable are you at interpreting numbers, percentages, and basic statistics?",
          "required": true,
          "leftLabel": "Not at all comfortable",
          "rightLabel": "Extremely comfortable",
          "numItems": 7
        },
        {
          "id": "confident-visuals",
          "type": "likert",
          "location": "belowStimulus",
          "prompt": "How confident are you in your ability to accurately interpret charts, graphs, and other visualizations?",
          "required": true,
          "leftLabel": "Not at all confident",
          "rightLabel": "Extremely confident",
          "numItems": 7
        },
        {
          "id": "political-ideology",
          "type": "likert",
          "location": "belowStimulus",
          "prompt": "In terms of your political views, do you think of yourself as:",
          "required": true,
          "leftLabel": "Very Liberal",
          "rightLabel": "Very Conservative",
          "numItems": 7
        }
      ]
    }
  },
  "sequence": {
    "order": "fixed",
    "components": [
      "introduction",
      "post-study-quant"
    ]
  }
}
